diff --git a/include/linux/compiler_types.h b/include/linux/compiler_types.h
index ed1c107124e4..3b361496b238 100644
--- a/include/linux/compiler_types.h
+++ b/include/linux/compiler_types.h
@@ -320,7 +320,14 @@ struct ftrace_likely_data {
  * __bdos on clang < 19.1.3 can be off by 4:
  * https://github.com/llvm/llvm-project/pull/112636
  */
-#ifdef CONFIG_CC_HAS_COUNTED_BY
+/*
+ * genksyms hashes the textual type of every exported symbol, attributes
+ * included. clang >= 18 emits __counted_by(), which would change the CRC of
+ * any symbol whose signature references such a struct (e.g. icc_set_bw())
+ * and break loading of the prebuilt vendor modules. The attribute does not
+ * change the ABI, so hide it from the genksyms pass only.
+ */
+#if defined(CONFIG_CC_HAS_COUNTED_BY) && !defined(__GENKSYMS__)
 # define __counted_by(member)		__attribute__((__counted_by__(member)))
 #else
 # define __counted_by(member)
